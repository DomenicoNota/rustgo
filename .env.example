# Local-only examples. Copy this file to .env before using Compose.
# Replace both credential values in any shared or deployed environment.
COMPOSE_PROJECT_NAME=logstream

# PostgreSQL. Keep DATABASE_URL credentials aligned with the three values above it.
POSTGRES_DB=logstream
POSTGRES_USER=logstream
POSTGRES_PASSWORD=local-only-example-password
DATABASE_URL=postgres://logstream:local-only-example-password@postgres:5432/logstream?sslmode=disable
DB_MAX_CONNS=10
DB_MIN_CONNS=1

# Kafka topics and persistence consumer identity.
KAFKA_BROKERS=kafka:9092
KAFKA_TOPIC=logs.raw
KAFKA_DLQ_TOPIC=logs.dlq
KAFKA_GROUP_ID=logstream-persistence

# Worker retry budget and local operations port.
WORKER_RETRY_MAX_ATTEMPTS=5
WORKER_RETRY_BASE_DELAY_MS=250
WORKER_RETRY_MAX_DELAY_MS=5000
WORKER_ATTEMPT_TIMEOUT_MS=10000
WORKER_OBSERVABILITY_PORT=9091

# API authentication and bounded ingestion limits. Multiple keys are comma-separated.
API_KEYS=local-only-example-key
MAX_BATCH_SIZE=500
MAX_BODY_BYTES=2097152

# Rust agent overrides. Compose supplies the internal API URL automatically.
LOGSTREAM_AGENT_ID=local-dev-agent-1
LOGSTREAM_API_KEY=local-only-example-key
RUST_LOG=info

# Browser-visible API origin used by the optional Compose ui profile.
VITE_API_BASE_URL=http://localhost:8080
